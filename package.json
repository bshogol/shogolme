{
  "name": "shogol-me",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-content.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "highlight.js": "^11.11.1",
    "node-html-parser": "^7.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
