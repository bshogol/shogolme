{
  "name": "shogol-me",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-content.mjs && node scripts/copy-fonts.mjs && node scripts/brand-assets.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "npm run gen && tsc -b --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "highlight.js": "^11.11.1",
    "node-html-parser": "^7.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  }
}
